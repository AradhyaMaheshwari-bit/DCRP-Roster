# =====================================================================
# DCRP-Roster — environment configuration template
# =====================================================================
# Copy this file to `.env` and fill in the real values. `.env` is
# git-ignored. NEVER commit real secrets.
# =====================================================================

# --- Discord ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# The guild (server) ID where the bot operates
GUILD_ID=

# Role ID allowed to approve role requests
HR_ROLE_ID=

# --- Google Sheets ---
# Absolute path to the Google service-account JSON key file
GOOGLE_CREDENTIALS_PATH=./secrets/google-sa.json

# Target production spreadsheet (the one the bot WRITES to)
TARGET_SPREADSHEET_ID=1WnQCGlkFp9oqT79SkkLTYW0K83My21r2B5mSxoxVp24

# Nova reference spreadsheet (READ-ONLY — never written to)
NOVA_SPREADSHEET_ID=1maTrRfFnbAbfE6TAH0X2n9blHcT2ofQDXiWn6QGH5Ko

# --- Logging ---
LOG_LEVEL=INFO

# --- Timezone (for date stamps written to Sheets) ---
TIMEZONE=Asia/Kolkata
